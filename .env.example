# Used by `docker compose up` (docker-compose.yml) to fill in the server
# container's secrets. Copy to .env in this same directory:
#   cp .env.example .env
# This is separate from server/.env, which is used for non-Docker local dev.

FRONTEND_URL=http://localhost:8080

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
QR_SECRET=replace-with-another-long-random-string

# Razorpay TEST MODE keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
