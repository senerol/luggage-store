# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Example for a local Postgres instance:
DATABASE_URL="postgresql://luggo:luggo@localhost:5432/luggo?schema=public"

# --- Auth ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- QR tokens ---
QR_SECRET=replace-with-another-long-random-string

# --- Razorpay (TEST MODE keys from https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret

# --- Misc ---
SERVICE_FEE_PERCENT=10
